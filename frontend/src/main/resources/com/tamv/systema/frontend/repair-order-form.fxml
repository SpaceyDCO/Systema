<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="450.0" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tamv.systema.frontend.RepairOrderFormController">
    <children>
        <GridPane>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="80.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="80.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Customer:">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </Label>
                <Label text="Equipment Name:" GridPane.rowIndex="1">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </Label>
                <Label text="Serial Number:" GridPane.rowIndex="2">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </Label>
                <Label text="Reported Issue:" GridPane.rowIndex="3">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </Label>
                <Label text="Status:" GridPane.rowIndex="4">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </Label>
                <Label text="Technician Notes:" GridPane.rowIndex="5">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </Label>

                <ComboBox fx:id="customerComboBox" maxWidth="1.7976931348623157E308" promptText="Select customer..." GridPane.columnIndex="1"> </ComboBox>

                <TextField fx:id="equipmentNameField" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </TextField>

                <TextField fx:id="serialNumberField" GridPane.columnIndex="1" GridPane.rowIndex="2">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </TextField>

                <TextArea fx:id="reportedIssueField" prefHeight="80.0" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </TextArea>

                <ComboBox fx:id="statusComboBox" maxWidth="1.7976931348623157E308" promptText="Select status..." GridPane.columnIndex="1" GridPane.rowIndex="4"> </ComboBox>

                <TextArea fx:id="technicianNotesField" prefHeight="80.0" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="5">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </TextArea>
            </children>
        </GridPane>

        <HBox prefHeight="23.0" prefWidth="410.0" />

        <HBox alignment="CENTER" prefHeight="30.0" prefWidth="410.0" spacing="20.0">
            <children>
                <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave" text="Save">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" text="Cancel">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </Button>
            </children>
        </HBox>

        <Label fx:id="errorLabel" textAlignment="CENTER" textFill="#750000">
            <font>
                <Font name="Georgia" size="18.0" />
            </font>
        </Label>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
