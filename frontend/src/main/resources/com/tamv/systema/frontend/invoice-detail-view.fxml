<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="detail-view-container" stylesheets="@styles/shared-forms.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tamv.systema.frontend.InvoiceFormController">

    <HBox alignment="CENTER_LEFT" styleClass="detail-header">
        <Button onAction="#onBack" styleClass="back-button" text="← Back to Invoices" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="deleteButton" onAction="#onDelete" styleClass="danger-button" text="🗑 Delete" />
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="form-scroll-pane" VBox.vgrow="ALWAYS">
        <VBox alignment="CENTER" spacing="20.0" styleClass="form-content">
            <padding>
                <Insets bottom="30" left="40" right="40" top="30" />
            </padding>

            <Label fx:id="titleLabel" styleClass="detail-title" text="Invoice Details" />

            <VBox spacing="15" styleClass="form-section">
                <Label styleClass="section-header" text="Basic Information" />

                <VBox spacing="5">
                    <Label styleClass="form-field-label" text="Customer *" />
                    <ComboBox fx:id="customerComboBox" maxWidth="Infinity" promptText="Select customer..." styleClass="form-field" />
                </VBox>

                <VBox spacing="5">
                    <Label styleClass="form-field-label" text="Invoice Date *" />
                    <DatePicker fx:id="invoiceDatePicker" maxWidth="Infinity" styleClass="form-field" />
                </VBox>

                <VBox spacing="5">
                    <Label styleClass="form-field-label" text="Status *" />
                    <ComboBox fx:id="statusComboBox" maxWidth="Infinity" promptText="Select status..." styleClass="form-field" />
                </VBox>
            </VBox>

            <VBox spacing="15" styleClass="form-section">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="section-header" text="Line Items" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#onAddLineItem" text="+ Add Item" />
                </HBox>

                <TableView fx:id="lineItemsTable" styleClass="line-items-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="productColumn" prefWidth="145.0" text="Product" />
                        <TableColumn fx:id="descriptionColumn" prefWidth="203.0" text="Description" />
                        <TableColumn fx:id="quantityColumn" prefWidth="91.0" text="Qty" />
                        <TableColumn fx:id="priceColumn" prefWidth="135.0" text="Unit Price" />
                        <TableColumn fx:id="totalColumn" prefWidth="113.0" text="Total" />
                        <TableColumn fx:id="actionsColumn" prefWidth="53.0" />
                    </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="20" styleClass="totals-box">
                    <Label styleClass="total-label" text="Subtotal:" />
                    <Label fx:id="subtotalLabel" styleClass="total-value" text="\$0.00" />
                </HBox>

                <Separator />

                <HBox alignment="CENTER_RIGHT" spacing="20" styleClass="totals-box">
                    <Label styleClass="total-label-final" text="Total:" />
                    <Label fx:id="totalLabel" styleClass="total-value-final" text="\$0.00" />
                </HBox>
            </VBox>

<!--            <VBox styleClass="form-section" spacing="15">-->
<!--                <Label text="Notes" styleClass="section-header"/>-->

<!--                <VBox spacing="5">-->
<!--                    <Label text="Additional Notes" styleClass="form-field-label"/>-->
<!--                    <TextArea fx:id="notesField"-->
<!--                              promptText="Payment terms, special instructions, etc."-->
<!--                              styleClass="form-field"-->
<!--                              prefRowCount="4"/>-->
<!--                </VBox>-->
<!--            </VBox> ADD LATER, additional information  but needs a field in the DB -->

            <Label fx:id="errorLabel" managed="false" styleClass="error-label" visible="false" wrapText="true" />

            <HBox alignment="CENTER_LEFT" spacing="15" styleClass="form-actions">
                <Button onAction="#onSave" styleClass="primary-button" text="Save Invoice" />
                <Button onAction="#onBack" styleClass="primary-button" text="Cancel" />
            </HBox>

        </VBox>
    </ScrollPane>

</VBox>
