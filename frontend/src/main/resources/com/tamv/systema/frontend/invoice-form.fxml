<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="600.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tamv.systema.frontend.InvoiceFormController">
    <children>
        <GridPane>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="400.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Customer:">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </Label>
                <Label text="Due Date:" GridPane.rowIndex="1">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </Label>
                <ComboBox fx:id="customerComboBox" maxWidth="1.7976931348623157E308" promptText="Select customer..." GridPane.columnIndex="1">
                </ComboBox>
                <DatePicker fx:id="dueDatePicker" maxWidth="1.7976931348623157E308" promptText="Select due date..." GridPane.columnIndex="1" GridPane.rowIndex="1">
                </DatePicker>
            </children>
        </GridPane>
        <Separator />
        <VBox spacing="10.0">
            <children>
                <Label text="Invoice Items:">
                    <font>
                        <Font name="Georgia Bold" size="14.0" />
                    </font>
                </Label>
                <TableView fx:id="itemsTable" prefHeight="250.0">
                    <columns>
                        <TableColumn fx:id="productColumn" prefWidth="250.0" text="Product" />
                        <TableColumn fx:id="quantityColumn" prefWidth="80.0" text="Quantity" />
                        <TableColumn fx:id="priceColumn" prefWidth="100.0" text="Price" />
                        <TableColumn fx:id="totalColumn" prefWidth="100.0" text="Total" />
                    </columns>
                </TableView>
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="addItemButton" onAction="#handleAddItem" text="Add Item">
                            <font>
                                <Font name="Georgia" size="12.0" />
                            </font>
                        </Button>
                        <Button fx:id="removeItemButton" onAction="#handleRemoveItem" text="Remove Selected">
                            <font>
                                <Font name="Georgia" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>
            </children>
        </VBox>
        <Separator />
        <HBox alignment="CENTER_RIGHT" spacing="20.0">
            <children>
                <Label text="Total Amount:">
                    <font>
                        <Font name="Georgia Bold" size="14.0" />
                    </font>
                </Label>
                <Label fx:id="totalLabel" text="\$ 0.00">
                    <font>
                        <Font name="Georgia Bold" size="16.0" />
                    </font>
                </Label>
            </children>
        </HBox>
        <GridPane fx:id="statusGrid" managed="false" visible="false">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="400.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Status:">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </Label>
                <ComboBox fx:id="statusComboBox" maxWidth="1.7976931348623157E308" promptText="Select status..." GridPane.columnIndex="1">
                </ComboBox>
            </children>
        </GridPane>
        <HBox prefHeight="10.0" />
        <HBox alignment="CENTER" prefHeight="30.0" spacing="20.0">
            <children>
                <Button fx:id="saveButton" mnemonicParsing="false" onAction="#handleSave" text="Save">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </Button>
                <Button fx:id="cancelButton" mnemonicParsing="false" onAction="#handleCancel" text="Cancel">
                    <font>
                        <Font name="Georgia" size="12.0" />
                    </font>
                </Button>
            </children>
        </HBox>
        <Label fx:id="errorLabel" textAlignment="CENTER" textFill="#750000">
            <font>
                <Font name="Georgia" size="14.0" />
            </font>
        </Label>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
