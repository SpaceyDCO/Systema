<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tamv.systema.frontend.InvoiceViewController">
    <children>
        <HBox spacing="10.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <TableView fx:id="invoiceTable" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="customerNameColumn" prefWidth="130.0" text="Customer" />
                        <TableColumn fx:id="invoiceDateColumn" prefWidth="100.0" text="Invoice Date" />
                        <TableColumn fx:id="dueDateColumn" prefWidth="100.0" text="Due Date" />
                        <TableColumn fx:id="totalAmountColumn" prefWidth="100.0" text="Total Amount" />
                        <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <VBox prefWidth="100.0" spacing="10.0">
                    <children>
                        <Button fx:id="newButton" maxWidth="1.7976931348623157E308" text="New..." onAction="#handleNewInvoice">
                            <font>
                                <Font name="Georgia" size="12.0" />
                            </font>
                        </Button>
                        <Button fx:id="editButton" maxWidth="1.7976931348623157E308" text="Edit..." onAction="#handleEditInvoice">
                            <font>
                                <Font name="Georgia" size="12.0" />
                            </font>
                        </Button>
                        <Button fx:id="deleteButton" maxWidth="1.7976931348623157E308" text="Delete" onAction="#handleDeleteInvoice">
                            <font>
                                <Font name="Georgia" size="12.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</AnchorPane>
