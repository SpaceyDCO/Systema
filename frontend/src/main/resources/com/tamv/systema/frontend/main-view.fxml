<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@styles/main-view.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tamv.systema.frontend.MainController">

    <left>
        <VBox minWidth="220" spacing="10.0" styleClass="sidebar">
            <HBox alignment="CENTER" styleClass="sidebar-header">
                <Label styleClass="app-title" text="Systema 🏥" />
            </HBox>
            <VBox alignment="CENTER" prefWidth="190.0" spacing="30.0" styleClass="nav-buttons">
                <Button fx:id="homeButton" onAction="#onHomeClicked" styleClass="nav-button selected" text="🏠 Home" />

                <Button fx:id="customersButton" onAction="#handleCustomersButton" styleClass="nav-button" text="👥 Customers" />

                <Button fx:id="invoicesButton" onAction="#handleInvoicesButton" styleClass="nav-button" text="📄 Invoices" />

                <Button fx:id="repairsButton" onAction="#handleRepairsButton" styleClass="nav-button" text="🔧 Repairs" />

                <Button fx:id="productsButton" onAction="#handleProductsButton" styleClass="nav-button" text="📦 Products" />
            <VBox.margin>
               <Insets />
            </VBox.margin>
            </VBox>
        </VBox>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-bar">
            <Region HBox.hgrow="ALWAYS" />
            <MenuButton fx:id="userMenuButton" styleClass="user-menu" text="👤 Spacey" textFill="WHITE">
                <items>
                    <MenuItem text="Profile" />
                    <MenuItem text="Settings" />
                    <SeparatorMenuItem />
                    <MenuItem text="Logout" />
                </items>
            <font>
               <Font name="Georgia" size="12.0" />
            </font>
            </MenuButton>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
        </StackPane>
    </center>

</BorderPane>
