<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.tamv.systema.frontend.CustomerViewController"
      styleClass="view-container"
      stylesheets="@styles/shared-views.css"
      spacing="20"
      alignment="TOP_CENTER">
    <HBox styleClass="view-header" alignment="CENTER_LEFT">
        <Label text="👥 Customers" styleClass="view-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Add Customer"
                styleClass="primary-button"
                onAction="#onAddCustomer"/>
    </HBox>
    <TextField fx:id="searchField"
               promptText="🔍 Search customers..."
               styleClass="search-bar"
               onKeyReleased="#onSearch"/>
    <ScrollPane styleClass="cards-scroll-pane"
                fitToWidth="true"
                VBox.vgrow="ALWAYS">
        <FlowPane fx:id="cardsContainer"
                  styleClass="cards-grid"
                  hgap="20"
                  vgap="20"
        />
    </ScrollPane>

</VBox>
